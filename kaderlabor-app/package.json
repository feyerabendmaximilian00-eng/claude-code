{
  "name": "kaderlabor",
  "productName": "Kaderlabor",
  "version": "1.2.0",
  "description": "Kaderanalyse für den FC-27-Karrieremodus als Windows-App",
  "main": "main.js",
  "private": true,
  "scripts": {
    "build:page": "node scripts/build-page.js",
    "start": "npm run build:page && electron .",
    "pack:win": "npm run build:page && electron-packager . Kaderlabor --platform=win32 --arch=x64 --out=dist --overwrite --asar --prune=true --ignore=^/dist --ignore=^/web --ignore=^/scripts --ignore=^/build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "33.4.11"
  }
}
